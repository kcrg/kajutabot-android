# AGP 9.4 / R8 full mode: keep rules scoped to reflection boundaries only.
# Retrofit and kotlinx.serialization publish/use their own generated rules.
# SignalR's Gson protocol uses Java reflection on these specific DTO fields;
# preserving field names is required for server camelCase JSON compatibility.
# Do not keep the entire API model package: request-only DTOs are compiled by
# kotlinx.serialization and can be optimized freely.
-keepclassmembers class com.tryniecki.kajutabot.api.model.queue.QueueSnapshotResponse {
    <fields>;
}
-keepclassmembers class com.tryniecki.kajutabot.api.model.queue.QueueEntryResponse {
    <fields>;
}
-keepclassmembers class com.tryniecki.kajutabot.api.model.common.PlaybackTrackResponse {
    <fields>;
}
-keepclassmembers class com.tryniecki.kajutabot.api.model.radio.RadioStateResponse {
    <fields>;
}
-keepclassmembers class com.tryniecki.kajutabot.api.model.playback.LocalVolumeStateDto {
    <fields>;
}

# SignalR Gson serializes/deserializes enum values by name.
-keepclassmembers enum com.tryniecki.kajutabot.api.model.queue.SkipOutcome {
    *;
}

# SignalR's own protocol messages are also reflection-driven. Keeping members
# rather than whole classes lets R8 remove unused implementation classes.
# Narrow further only after validating the minified SignalR handshake,
# heartbeat, queue updates, command invocations and reconnect path.
-keepclassmembers class com.microsoft.signalr.** {
    <init>(...);
    <fields>;
}

# Retrofit/Gson consumer rules already handle reflective generic signatures.
# SLF4J 1.7's legacy optional binding is looked up dynamically by SignalR.
-dontwarn org.slf4j.impl.StaticLoggerBinder
