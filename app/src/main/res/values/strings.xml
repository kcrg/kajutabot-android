    <string name="onboarding_player_title">Control what plays on Discord</string>
    <string name="onboarding_player_description">Your phone works as a remote for KajutaBot on the selected voice channel. See the current track and progress, skip or stop playback, enable repeat, and save tracks to favorites.</string>
    <string name="onboarding_queue_title">Full control of the queue</string>
    <string name="onboarding_queue_description">Press and drag a track to change its position. Remove individual entries, clear the whole queue, or quickly open search from the player.</string>
    <string name="onboarding_add_title">Add music your way</string>
    <string name="onboarding_add_description">Type a track name, paste a direct link, or choose KajutaBot from Android’s Share menu, for example in YouTube. The link goes straight to the add screen, so you do not need to copy it between apps manually.</string>
    <string name="onboarding_favorites_title">Favorites always at hand</string>
    <string name="onboarding_favorites_description">Save tracks for later and add them again with one tap. You can also add all favorites to the queue at once and optionally shuffle their order.</string>
    <string name="onboarding_radio_title">Radio when the queue ends</string>
    <string name="onboarding_radio_description">Enable Radio with the radio button in the player. When the regular queue becomes empty, KajutaBot automatically picks a random cached track so the music can keep playing without adding more tracks manually.</string>
    <string name="onboarding_miniplayer_title">Controls stay with you</string>
    <string name="onboarding_miniplayer_description">While something is playing, the mini player stays above the bottom navigation on other tabs. It shows progress and lets you quickly favorite or skip the track, or return to the full player.</string>
    <string name="onboarding_system_media_title">Control playback from Android too</string>
    <string name="onboarding_system_media_description">While playing, Android shows a system media card. See the current track and use quick actions without returning to the app.</string>
    <string name="onboarding_guest_description">Your phone is a remote for KajutaBot on the demo Discord server. See the current track and progress and use the same basic controls without typing commands.</string>
    <string name="onboarding_selection_title">Where do you want to control the bot?</string>
    <string name="onboarding_selection_guest_description">The demo server is already selected. Choose a voice channel; you can change it later from the player screen.</string>
    <string name="onboarding_selection_description">Choose a Discord server and then a voice channel. You can change this later from the player screen.</string>
